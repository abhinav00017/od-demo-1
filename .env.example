# Copy to .env.local for local work. On Vercel, set these in Project Settings > Environment Variables.

# Postgres connection string (Neon). Missing = bookings live in server memory and vanish on restart.
DATABASE_URL=

# Password for /clinic/website/admin. Missing = "demo" in `next dev`, dashboard off in production.
ADMIN_PASSWORD=

# Secret that signs the admin cookie. Missing = ADMIN_PASSWORD is used. Use a long random string.
ADMIN_SECRET=

# Password for the tile showroom CRM at /tiles/crm. Missing = "demo" in `next dev`, CRM off in production.
CRM_ADMIN_PASSWORD=

# Secret that signs the CRM cookie (crm_session). Missing = CRM_ADMIN_PASSWORD is used. Use a long random string.
CRM_ADMIN_SECRET=

# Resend API key for the new-booking email to the clinic. Missing = no email, one log line.
RESEND_API_KEY=

# Where the new-booking email goes. Comma-separate several addresses.
CLINIC_NOTIFY_EMAIL=

# Optional. Sender for that email. Default "Lotus demo <onboarding@resend.dev>", which only mails your own Resend address.
NOTIFY_FROM=

# --- WhatsApp. See docs/whatsapp-templates.md. ---

# twilio, meta or fake. Missing = twilio if the three TWILIO_* vars are set, else meta if WHATSAPP_TOKEN is set, else fake.
WHATSAPP_PROVIDER=

# --- WhatsApp via Twilio (quickstart sender for demos). ---

# Twilio Account SID, starts with AC. Twilio console > Account Info.
TWILIO_ACCOUNT_SID=

# Twilio Auth Token, next to the SID. Secret. Also checks Twilio's status callback signatures.
TWILIO_AUTH_TOKEN=

# Sending WhatsApp number with country code. Twilio's quickstart gives each account its own sender; the console shows it.
# (The old shared sandbox was +14155238886.)
TWILIO_WHATSAPP_FROM=

# Twilio Content Template sids, start with HX. Twilio console > Messaging > Content Template Builder.
# The quickstart sender only sends business-initiated messages as content templates (no sid = error 21654).
# Set = sends ContentSid + ContentVariables, no Body. Unset = sends plain text, which only lands inside a 24 h session.
# Confirmation variables: {{1}} date, {{2}} slot.
TWILIO_CONTENT_SID_CONFIRM=

# Reminder: {{1}} date, {{2}} slot. Unset = reuses TWILIO_CONTENT_SID_CONFIRM.
TWILIO_CONTENT_SID_REMINDER=

# Clinic alert: {{1}} first name and visit type, {{2}} date and slot. Unset = reuses TWILIO_CONTENT_SID_CONFIRM.
TWILIO_CONTENT_SID_CLINIC_ALERT=

# CRM quote on WhatsApp: {{1}} first name, {{2}} quote number, {{3}} total, {{4}} quote link.
# Unset = plain text (Body), which only lands inside a 24 h session. Never reuses TWILIO_CONTENT_SID_CONFIRM (that one is the clinic's).
TWILIO_CONTENT_SID_CRM_QUOTE=

# CRM 2-day reminder: {{1}} first name, {{2}} quote number, {{3}} quote link. Unset = plain text, as above.
TWILIO_CONTENT_SID_CRM_REMINDER=

# The word after "join" on Twilio's quickstart page, like twilio-trail. Not a secret.
# Set = the booking success screen shows an "Open WhatsApp" button and the dashboard a QR, both opening
# WhatsApp with "join <keyword>" typed in. Needed on a trial sender: Twilio only delivers to numbers that joined.
# Unset (or provider not twilio) = no join step shown. Leave it unset for a verified business sender.
TWILIO_JOIN_KEYWORD=

# This site's public origin, no trailing slash, e.g. https://od-demo-lyart.vercel.app. Set = Twilio posts delivery statuses back.
WHATSAPP_PUBLIC_URL=

# Local testing only: send Twilio calls to a mock server instead of api.twilio.com. Ignored in production.
TWILIO_API_BASE=

# --- WhatsApp via Meta Cloud API (needs business verification for real numbers). ---

# Meta access token (system-user token for real use). Missing = fake sender that only logs.
WHATSAPP_TOKEN=

# Phone number ID from the Meta app's WhatsApp > API Setup page. Default is the test number 1300202886519854.
WHATSAPP_PHONE_NUMBER_ID=

# Template sent on Confirm. Default hello_world until the custom one is approved.
WHATSAPP_TEMPLATE_CONFIRM=

# Template sent by the 6 pm reminder job. Default hello_world until the custom one is approved.
WHATSAPP_TEMPLATE_REMINDER=

# Template sent to the clinic's own number on every new booking. Default hello_world until the custom one is approved.
WHATSAPP_TEMPLATE_CLINIC_ALERT=

# Meta templates for the CRM quote and reminder. Default hello_world. A custom one gets the same variables as the Twilio ones, in order.
WHATSAPP_TEMPLATE_CRM_QUOTE=
WHATSAPP_TEMPLATE_CRM_REMINDER=

# The clinic's own WhatsApp number, digits only with country code, no plus (91 and 10 digits). Missing = no clinic alert, one log line.
CLINIC_WHATSAPP=

# Language code of the custom templates. Default en_US. hello_world always uses en_US.
WHATSAPP_TEMPLATE_LANG=

# Any string you choose. Type the same value in the Meta app's webhook settings.
WHATSAPP_VERIFY_TOKEN=

# Meta app secret (App settings > Basic). Checks webhook signatures. Missing = signatures not checked.
WHATSAPP_APP_SECRET=

# Set to 1 to force the fake sender even when WHATSAPP_TOKEN is set.
WHATSAPP_FAKE=

# Long random string. Vercel Cron sends it as a Bearer token to /api/cron/reminders and /api/cron/crm-followups. Missing = the jobs refuse to run.
CRON_SECRET=
